# PRD Intelligence — Environment Configuration
# Copy to .env and fill in your values.

# === LLM Provider (required) ===
# Options: openai, anthropic, gemini, custom
PRD_LLM_PROVIDER=openai

# API key for the chosen provider
PRD_LLM_API_KEY=sk-your-key-here

# Model override (optional — provider-specific default is used if omitted)
# OpenAI: gpt-4o, gpt-4o-mini, o3-mini, etc.
# Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, etc.
# Gemini: gemini-2.5-flash, gemini-2.5-pro, etc.
# PRD_LLM_MODEL=gpt-4o

# Base URL override (for custom OpenAI-compatible endpoints like Ollama, vLLM, Azure)
# PRD_LLM_BASE_URL=https://api.openai.com/v1

# === Web Search for PRD Enrichment (optional) ===
# Used when --enrich flag is passed. Enables live market data augmentation.
PRD_WEB_SEARCH_KEY=
# Options: tavily (default), serpapi
# PRD_WEB_SEARCH_TYPE=tavily

# Max results per search query (default: 5)
# PRD_ENRICH_MAX_RESULTS=5
